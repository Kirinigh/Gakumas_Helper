{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kirinigh/Gakumas_Helper/schemas/release-manifest-v1.json",
  "title": "Gakumas Helper full derived release manifest",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "qualification",
    "release",
    "application",
    "compatibility",
    "components",
    "redistribution",
    "privacy_gate",
    "known_gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "MaaGakumasu-GakumasHelper" },
    "qualification": { "enum": ["arena_preview", "arena_release", "stable"] },
    "release": {
      "type": "object",
      "required": ["version", "channel", "repository", "asset", "asset_bytes", "asset_sha256", "platform"],
      "properties": {
        "version": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
        "channel": { "enum": ["alpha", "beta", "stable"] },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "asset": { "type": "string", "pattern": "^MaaGakumasu-win-x86_64-v.+\\.zip$" },
        "asset_bytes": { "type": "integer", "minimum": 1 },
        "asset_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "platform": { "const": "win-x86_64" }
      },
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": ["interface_version", "source_repository", "source_revision", "upstream", "mfa_core", "python_packages"],
      "properties": {
        "interface_version": { "type": "integer" },
        "source_repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstream": {
          "type": "object",
          "required": ["repository", "tag", "archive", "sha256"],
          "properties": {
            "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
            "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "archive": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
          },
          "additionalProperties": false
        },
        "mfa_core": { "$ref": "#/$defs/mfa_core" },
        "framework": { "$ref": "#/$defs/framework" },
        "python_packages": {
          "type": "object",
          "required": ["numpy", "onnxruntime", "opencv-python-headless", "pillow", "pyyaml"],
          "properties": {
            "numpy": { "type": "string", "minLength": 1 },
            "onnxruntime": { "type": "string", "minLength": 1 },
            "opencv-python-headless": { "type": "string", "minLength": 1 },
            "pillow": { "type": "string", "minLength": 1 },
            "pyyaml": { "type": "string", "minLength": 1 },
            "maafw": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "card_business_id_count",
        "card_visual_identity_count",
        "card_embedding_dimension",
        "arena_card_business_id_max",
        "arena_badge_rule_version",
        "p_item_business_id_count",
        "p_item_minimum_capture_size",
        "arena_engine_revision",
        "arena_adapter_protocol",
        "arena_calibration_schema"
      ],
      "properties": {
        "card_business_id_count": { "type": "integer", "minimum": 1 },
        "card_visual_identity_count": { "type": "integer", "minimum": 1 },
        "card_embedding_dimension": { "type": "integer", "minimum": 1 },
        "arena_card_business_id_max": { "type": "integer", "minimum": 1 },
        "arena_badge_rule_version": { "type": "string", "minLength": 1 },
        "p_item_business_id_count": { "type": "integer", "minimum": 1 },
        "p_item_minimum_capture_size": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "arena_engine_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "arena_adapter_protocol": { "const": "2.0" },
        "arena_calibration_schema": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "required": [
        "card_vision",
        "arena_card_vision",
        "arena_badge_reference",
        "arena_cost_reference",
        "p_item_reference",
        "arena_engine_catalog"
      ],
      "properties": {
        "card_vision": { "$ref": "#/$defs/component" },
        "arena_card_vision": { "$ref": "#/$defs/component" },
        "arena_badge_reference": { "$ref": "#/$defs/component" },
        "arena_cost_reference": { "$ref": "#/$defs/component" },
        "p_item_reference": { "$ref": "#/$defs/component" },
        "arena_engine_catalog": { "$ref": "#/$defs/component" }
      },
      "additionalProperties": false
    },
    "redistribution": {
      "type": "object",
      "required": [
        "project_and_upstream_license",
        "gakumas_tools_license",
        "self_trained_assets",
        "user_runtime_capture_or_private_training_corpus_in_release",
        "upstream_resource_templates_in_release",
        "notices_embedded",
        "notice_sha256",
        "dependency_source_normalizations"
      ],
      "properties": {
        "project_and_upstream_license": { "const": "AGPL-3.0" },
        "gakumas_tools_license": { "const": "BSD-3-Clause" },
        "self_trained_assets": { "const": "approved_for_this_release_by_human_gate" },
        "user_runtime_capture_or_private_training_corpus_in_release": { "const": false },
        "upstream_resource_templates_in_release": { "const": true },
        "notices_embedded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 7,
          "uniqueItems": true
        },
        "notice_sha256": {
          "type": "object",
          "required": [
            "LICENSE",
            "ASSET_PROVENANCE.md",
            "THIRD_PARTY_NOTICES/gakumas-tools-LICENSE",
            "THIRD_PARTY_NOTICES/GAME-CONTENT-NOTICE.md",
            "THIRD_PARTY_NOTICES/MFAAvalonia-LICENSE",
            "assets/arena-winrate/THIRD_PARTY_NOTICES/gakumas-tools-LICENSE",
            "assets/arena-winrate/THIRD_PARTY_NOTICES/Node.js-LICENSE"
          ],
          "properties": {
            "LICENSE": { "$ref": "#/$defs/sha256" },
            "ASSET_PROVENANCE.md": { "$ref": "#/$defs/sha256" },
            "THIRD_PARTY_NOTICES/gakumas-tools-LICENSE": { "$ref": "#/$defs/sha256" },
            "THIRD_PARTY_NOTICES/GAME-CONTENT-NOTICE.md": { "$ref": "#/$defs/sha256" },
            "THIRD_PARTY_NOTICES/MFAAvalonia-LICENSE": { "$ref": "#/$defs/sha256" },
            "assets/arena-winrate/THIRD_PARTY_NOTICES/gakumas-tools-LICENSE": { "$ref": "#/$defs/sha256" },
            "assets/arena-winrate/THIRD_PARTY_NOTICES/Node.js-LICENSE": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "dependency_source_normalizations": {
          "type": "object",
          "properties": {
            "maa/define.py": {
              "const": "replace_nonfunctional_user_profile_example_with_relative_log_path"
            }
          },
          "patternProperties": {
            "^maafw-[0-9]+\\.[0-9]+\\.[0-9]+\\.dist-info/RECORD$": {
              "const": "refresh_normalized_source_hash_and_size"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "privacy_gate": {
      "type": "object",
      "required": ["schema_version", "policy", "files_scanned", "bytes_scanned"],
      "properties": {
        "schema_version": { "const": 1 },
        "policy": { "const": "reject_local_runtime_state_private_captures_machine_paths_and_credentials" },
        "files_scanned": { "type": "integer", "minimum": 1 },
        "bytes_scanned": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "known_gates": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "qualification": { "const": "arena_preview" } } },
      "then": { "properties": { "release": { "properties": { "channel": { "const": "beta" } } } } }
    },
    {
      "if": { "properties": { "qualification": { "const": "arena_release" } } },
      "then": { "properties": { "release": { "properties": { "channel": { "const": "stable" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "component": {
      "type": "object",
      "required": ["manifest", "manifest_sha256"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "framework": {
      "type": "object",
      "required": ["repository", "version", "archive", "sha256", "files", "license"],
      "properties": {
        "repository": { "const": "https://github.com/MaaXYZ/MaaFramework" },
        "native_layout": { "const": "shared" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "archive": { "type": "string", "pattern": "^MAA-win-x86_64-v[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "object",
          "minProperties": 9,
          "propertyNames": {
            "pattern": "^(runtimes/win-x64/native/.+|python/Lib/site-packages/maa/bin/.+|python/Lib/site-packages/maafw-[0-9]+\\.[0-9]+\\.[0-9]+\\.dist-info/(METADATA|RECORD)|MaaAgentBinary/.+|libs/MaaAgentBinary/.+|share/MaaAgentBinary/.+|requirements\\.txt|THIRD_PARTY_NOTICES/MaaFramework-LICENSE)$"
          },
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "license": {
          "type": "object",
          "required": ["spdx", "upstream_file", "install_path", "sha256"],
          "properties": {
            "spdx": { "const": "LGPL-3.0" },
            "upstream_file": { "const": "LICENSE.md" },
            "install_path": { "const": "THIRD_PARTY_NOTICES/MaaFramework-LICENSE" },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mfa_core": {
      "type": "object",
      "required": [
        "schema_version",
        "component",
        "status",
        "bundle_manifest_sha256",
        "upstream",
        "patch",
        "build",
        "input",
        "payload",
        "license"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "component": { "const": "mfaavalonia_core" },
        "status": { "const": "READY" },
        "bundle_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "upstream": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "commit",
            "source_archive",
            "source_archive_sha256",
            "version_checker_git_blob_sha1"
          ],
          "properties": {
            "repository": { "const": "https://github.com/MaaXYZ/MFAAvalonia" },
            "tag": { "const": "v2.15.2" },
            "commit": { "const": "6065fe33798b72906c5079fa6f210646801d9a5c" },
            "source_archive": { "const": "MFAAvalonia-2.15.2.zip" },
            "source_archive_sha256": { "const": "76DD02AFE4B1529B1D4F6416B3442E1BD7E64F13B72D8A3B428F955B5E26F67A" },
            "version_checker_git_blob_sha1": { "const": "6e6d1118fa414ba21c7efa4f15a58ad95dd08bd7" }
          },
          "additionalProperties": false
        },
        "patch": {
          "type": "object",
          "required": ["path", "sha256", "scope"],
          "properties": {
            "path": { "const": "tools/deployment/mfa/MFAAvalonia-v2.15.2-resource-update-github-fallback.patch" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "scope": {
              "type": "array",
              "prefixItems": [
                { "const": "resource_update_check" },
                { "const": "resource_update_apply" },
                { "const": "deterministic_build_path" },
                { "const": "diagnostic_log_export" },
                { "const": "dynamic_option_cases" },
                { "const": "startup_template_and_saved_layout" }
              ],
              "minItems": 6,
              "maxItems": 6
            }
          },
          "additionalProperties": false
        },
        "build": {
          "type": "object",
          "required": [
            "sdk_version_components",
            "sdk_archive_sha512",
            "configuration",
            "runtime",
            "project",
            "source_revision_id",
            "sentry_project_directory",
            "compiler_path_map_target",
            "project_directory_override_scope",
            "continuous_integration_build",
            "deterministic",
            "incremental_build",
            "max_cpu_count",
            "sentry_cli"
          ],
          "properties": {
            "sdk_version_components": {
              "type": "array",
              "prefixItems": [
                { "const": 10 },
                { "const": 0 },
                { "const": 400 }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "sdk_archive_sha512": { "const": "9B8B88590E4DA131BFD0DA7AA089D0FC04D5418D5F8607EC13D55DC5A17B4399AFD54D496C12657FA05C6C6546DC5EAB930F26AC6C50F2D3A7712C0FB378C366" },
            "configuration": { "const": "Release" },
            "runtime": { "const": "win-x64" },
            "project": { "const": "MFAAvalonia/MFAAvalonia.csproj" },
            "source_revision_id": { "const": "6065fe33798b72906c5079fa6f210646801d9a5c" },
            "sentry_project_directory": { "const": "/_/MFAAvalonia/" },
            "compiler_path_map_target": { "const": "/_/MFAAvalonia/" },
            "project_directory_override_scope": { "const": "WriteSentryAttributes" },
            "continuous_integration_build": { "const": true },
            "deterministic": { "const": true },
            "incremental_build": { "const": false },
            "max_cpu_count": { "const": 1 },
            "sentry_cli": { "const": false }
          },
          "additionalProperties": false
        },
        "input": {
          "type": "object",
          "required": ["baseline_dll_sha256"],
          "properties": {
            "baseline_dll_sha256": { "const": "2DF2226CE45FCE8AF0C4DF8022F399B0FA74E8378C9B23C4177BAC5EE6C295C8" }
          },
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "required": ["bundle_path", "install_path", "sha256", "size"],
          "properties": {
            "bundle_path": { "const": "MFAAvalonia.Core.dll" },
            "install_path": { "const": "libs/MFAAvalonia.Core.dll" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "required": ["spdx", "upstream_file", "sha256"],
          "properties": {
            "spdx": { "const": "GPL-3.0-only" },
            "upstream_file": { "const": "LICENSE" },
            "sha256": { "const": "3972DC9744F6499F0F9B2DBF76696F2AE7AD8AF9B23DDE66D6AF86C9DFB36986" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
