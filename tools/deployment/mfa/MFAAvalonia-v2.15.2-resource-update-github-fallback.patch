+    }
+    private static Version Stable(string value)
+    {
+        if (!System.Text.RegularExpressions.Regex.IsMatch(value, @"^v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$"))
+            throw new InvalidDataException("增量更新仅接受正式语义版本。");
+        return Version.Parse(value[1..]);
+    }
+    private static bool SameLine(string left, string right)
+    {
