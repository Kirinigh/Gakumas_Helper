+        if (stateHash != null && (!File.Exists(PathIn(root, StateName)) || !Hash(PathIn(root, StateName)).Equals(stateHash, StringComparison.OrdinalIgnoreCase)))
+            throw new InvalidDataException("版本基底清单不一致。");
+        var actual = ManagedFiles(root).Where(p => p != StateName && (!refreshRuntime || !RuntimeRefreshPath(p)));
