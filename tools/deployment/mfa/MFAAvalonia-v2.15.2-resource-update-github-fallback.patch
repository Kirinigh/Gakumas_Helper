+                // renew this display copy. No selection or sub-option state is persisted here.
+                comboBox.ItemsSource = DynamicOptionCases.DisplayCases(interfaceOption);
+                comboBox.SelectedItem = interfaceOption.Cases?.ElementAtOrDefault(option.Index ?? 0);
+                if (migrated)
+                {
+                    UpdateSubOptions(option.Index ?? 0);
+                    saveConfigurationAction();
+                }
+            }
+            finally
+            {
+                refreshingCases = false;
+            }
+        }
+
+        if (interfaceOption.DynamicCases && interfaceOption.IsSelect)
+        {
+            comboBox.DropDownOpened += (_, _) => RefreshDynamicCases();
+            comboBox.PropertyChanged += (_, change) =>
+            {
+                if (change.Property == Control.IsEnabledProperty && comboBox.IsEnabled) RefreshDynamicCases();
+            };
+        }
+
         UpdateSubOptions(option.Index ?? 0);
         ComboBoxExtensions.SetDisableNavigationOnLostFocus(comboBox, true);
         ComboBoxExtensions.SetCanSearch(comboBox, true);
