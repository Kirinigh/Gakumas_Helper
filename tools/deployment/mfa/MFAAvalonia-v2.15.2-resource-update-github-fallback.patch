diff --git a/MFAAvalonia/Directory.Build.targets b/MFAAvalonia/Directory.Build.targets
new file mode 100644
index 0000000..54699de
--- /dev/null
+++ b/MFAAvalonia/Directory.Build.targets
@@ -0,0 +1,18 @@
+<Project>
+  <Target Name="GakumasHelperSetSentryProjectDirectory"
+          BeforeTargets="WriteSentryAttributes"
+          Condition="'$(MSBuildProjectName)' == 'MFAAvalonia'">
+    <PropertyGroup>
+      <GakumasHelperOriginalProjectDir>$(ProjectDir)</GakumasHelperOriginalProjectDir>
+      <ProjectDir>/_/MFAAvalonia/</ProjectDir>
+    </PropertyGroup>
+  </Target>
+
+  <Target Name="GakumasHelperRestoreProjectDirectory"
+          AfterTargets="WriteSentryAttributes"
+          Condition="'$(GakumasHelperOriginalProjectDir)' != ''">
+    <PropertyGroup>
+      <ProjectDir>$(GakumasHelperOriginalProjectDir)</ProjectDir>
+    </PropertyGroup>
+  </Target>
+</Project>
