+        if (!File.Exists(archive)) await Download(client, plan.Full, archive, plan.Budget, progress);
+        var step = new Step { Metadata = plan.Target, Asset = plan.Full, Directory = Path.Combine(plan.Work, "full") };
+        progress?.Invoke("正在解压并校验完整更新", 0, 0);
+        Extract(step, archive, true);
+        plan.IsDelta = false;
+        plan.Steps = new List<Step> { step };
+    }
+    internal static void Extract(Step step, string archive, bool full)
+    {
+        if (Directory.Exists(step.Directory)) throw new IOException("更新暂存目录已存在。");
+        Directory.CreateDirectory(step.Directory);
+        using var zip = ZipFile.OpenRead(archive);
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var entry in zip.Entries)
+        {
+            if (entry.FullName.EndsWith('/')) continue;
+            var target = PathIn(step.Directory, entry.FullName);
+            if (!seen.Add(entry.FullName) || (entry.ExternalAttributes >> 16 & 0xF000) == 0xA000) throw new InvalidDataException("更新包包含重复路径或链接。");
+            if (entry.FullName != StateName && entry.FullName != "changes.json" && !step.Metadata.target.files.ContainsKey(entry.FullName))
+                throw new InvalidDataException("更新包含有清单外文件。");
+            Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+            entry.ExtractToFile(target);
+        }
+        if (!Hash(PathIn(step.Directory, StateName)).Equals(step.Metadata.state_sha256, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("目标清单校验失败。");
+        var state = JsonSerializer.Deserialize<State>(File.ReadAllText(PathIn(step.Directory, StateName)))!;
+        if (!JsonNode.DeepEquals(JsonSerializer.SerializeToNode(state), JsonSerializer.SerializeToNode(step.Metadata.target))) throw new InvalidDataException("目标清单内容不一致。");
+        if (full) VerifyTree(step.Directory, step.Metadata.target, step.Metadata.state_sha256);
+        else
+        {
+            var delta = step.Metadata.delta!;
+            var expected = step.Metadata.target.files.Where(p => !delta.@base.files.TryGetValue(p.Key, out var old) || old != p.Value || (step.Metadata.target.runtime_refresh && RuntimeRefreshPath(p.Key))).Select(p => p.Key).Append(StateName).ToHashSet(StringComparer.OrdinalIgnoreCase);
