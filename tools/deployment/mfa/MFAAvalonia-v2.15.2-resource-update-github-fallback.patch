+            var changes = JsonNode.Parse(File.ReadAllText(PathIn(step.Directory, "changes.json")))!.AsObject();
+            string[] Values(string name) => changes[name]?.AsArray().Select(p => p!.GetValue<string>()).ToArray() ?? throw new InvalidDataException("增量变更表不完整。");
+            if (!Values("deleted").ToHashSet().SetEquals(delta.@base.files.Keys.Except(step.Metadata.target.files.Keys))
+                || !Values("added").Concat(Values("modified")).ToHashSet().SetEquals(expected)
+                || Values("deleted_dir").Length != 0 || Values("added_dir").Length != 0) throw new InvalidDataException("增量增删改清单不一致。");
+            foreach (var relative in expected.Where(p => p != StateName))
+                if (!Hash(PathIn(step.Directory, relative)).Equals(step.Metadata.target.files[relative], StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("增量文件校验失败。");
+        }
+    }
+    internal static void Apply(Plan plan, Action<string>? beforeMutation = null)
+    {
+        using var transaction = new VersionChecker.UpdateFileTransaction(plan.Work);
+        try
+        {
+            foreach (var step in plan.Steps)
+            {
+                if (plan.IsDelta) VerifyTree(plan.Root, step.Metadata.delta!.@base, step.Metadata.delta!.base_state_sha256, step.Metadata.target.runtime_refresh);
+                var target = step.Metadata.target;
+                var deleted = plan.IsDelta ? step.Metadata.delta!.@base.files.Keys.Except(target.files.Keys)
+                    : ManagedFiles(plan.Root).Where(p => p != StateName && !target.files.ContainsKey(p));
+                if (target.runtime_refresh)
+                    deleted = deleted.Concat(ManagedFiles(plan.Root).Where(p => RuntimeRefreshPath(p) && !target.files.ContainsKey(p))).Distinct();
+                foreach (var relative in deleted.ToArray())
+                {
+                    beforeMutation?.Invoke(relative);
+                    transaction.DeleteFile(PathIn(plan.Root, relative));
+                }
+                foreach (var source in Directory.EnumerateFiles(step.Directory, "*", SearchOption.AllDirectories))
+                {
+                    var relative = Path.GetRelativePath(step.Directory, source).Replace('\\', '/');
+                    if (relative is "changes.json" or StateName) continue;
+                    beforeMutation?.Invoke(relative);
+                    transaction.ReplaceFile(source, PathIn(plan.Root, relative), CancellationToken.None);
+                }
+                transaction.ReplaceFile(PathIn(step.Directory, StateName), PathIn(plan.Root, StateName), CancellationToken.None);
+                VerifyTree(plan.Root, target, step.Metadata.state_sha256);
+            }
+            VerifyTree(plan.Root, plan.Target.target, plan.Target.state_sha256);
+            transaction.Commit();
+        }
+        catch
+        {
+            if (!transaction.RollbackChecked()) throw new RollbackIncompleteException("更新回滚未完整完成；已保留备份，不再尝试完整更新。");
+            throw;
+        }
+    }
+    internal sealed class RollbackIncompleteException(string message) : IOException(message);
+    internal static async Task Execute(Plan plan, HttpClient client, Action<string>? beforeMutation = null)
+    {
+        try { Apply(plan, beforeMutation); }
+        catch (RollbackIncompleteException) { throw; }
+        catch (Exception error) when (plan.IsDelta && error is IOException or InvalidDataException)
+        {
+            if (plan.Budget.Remaining-- <= 0) throw;
+            await PrepareFull(plan, client);
+            Apply(plan);
+        }
+    }
+
+    internal static async Task LaunchWorker(Plan plan, string token, string proxy)
+    {
+        var shadow = Path.Combine(plan.Work, "worker");
+        Directory.CreateDirectory(shadow);
+        // A locally modified base must not supply the worker for a full repair.
+        var workerSource = plan.IsDelta ? plan.Root : plan.Steps.Single().Directory;
+        if (plan.IsDelta) VerifyTree(plan.Root, plan.Steps[0].Metadata.delta!.@base, plan.Steps[0].Metadata.delta!.base_state_sha256, plan.Steps[0].Metadata.target.runtime_refresh);
+        // Run an unchanged copy outside the install tree, including its own Core/runtime.
+        foreach (var relative in ManagedFiles(workerSource))
+        {
+            if (Protected(relative) || (relative.Contains('/') && !relative.StartsWith("libs/") && !relative.StartsWith("runtimes/"))) continue;
+            var destination = PathIn(shadow, relative);
+            Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
+            File.Copy(PathIn(workerSource, relative), destination);
+        }
+        plan.Executable = plan.Target.target.files.ContainsKey("MaaGakumasu.exe") ? "MaaGakumasu.exe"
+            : Path.GetRelativePath(plan.Root, Environment.ProcessPath!).Replace('\\', '/');
+        PathIn(plan.Root, plan.Executable);
+        using var parent = Process.GetCurrentProcess();
+        plan.ParentPid = parent.Id;
+        plan.ParentStart = parent.StartTime.ToUniversalTime().Ticks;
+        var planFile = Path.Combine(plan.Work, "plan.json");
+        await File.WriteAllTextAsync(planFile, JsonSerializer.Serialize(plan));
+        var pipeName = "gkh-update-" + Guid.NewGuid().ToString("N");
+        using var pipe = new NamedPipeServerStream(pipeName, PipeDirection.Out, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous | PipeOptions.CurrentUserOnly);
+        var start = new ProcessStartInfo(PathIn(shadow, plan.Executable)) { UseShellExecute = false, CreateNoWindow = true, WorkingDirectory = shadow };
+        start.ArgumentList.Add("--gkh-update-worker");
+        start.ArgumentList.Add(planFile);
+        start.ArgumentList.Add(pipeName);
+        using var worker = Process.Start(start) ?? throw new IOException("无法启动更新进程。");
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+        await pipe.WaitForConnectionAsync(timeout.Token);
+        // Credentials exist only in the same-user pipe and worker memory, never in plan/logs/arguments.
+        await JsonSerializer.SerializeAsync(pipe, new Secrets { Token = token, Proxy = proxy }, cancellationToken: timeout.Token);
+        await pipe.FlushAsync(timeout.Token);
+        WriteResult(plan, "pending", "更新包已校验，等待程序退出后应用。");
+    }
+    internal static int RunWorker(string planFile, string pipeName)
+    {
+        Plan? plan = null;
+        try
+        {
+            plan = JsonSerializer.Deserialize<Plan>(File.ReadAllText(planFile)) ?? throw new InvalidDataException("更新计划缺失。");
+            if (plan.Root == AppContext.BaseDirectory || !Path.GetFullPath(plan.Work).StartsWith(Path.GetFullPath(plan.Root) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("更新工作目录无效。");
+            using var pipe = new NamedPipeClientStream(".", pipeName, PipeDirection.In, PipeOptions.CurrentUserOnly);
+            pipe.Connect(30000);
+            var secrets = JsonSerializer.Deserialize<Secrets>(pipe) ?? new Secrets();
+            using var handler = new HttpClientHandler();
+            if (!string.IsNullOrWhiteSpace(secrets.Proxy))
+            {
+                var proxy = new Uri(secrets.Proxy);
+                var address = new UriBuilder(proxy) { UserName = "", Password = "" };
+                var configuredProxy = new WebProxy(address.Uri);
+                if (!string.IsNullOrEmpty(proxy.UserInfo))
+                {
+                    var credentials = proxy.UserInfo.Split(':', 2);
+                    configuredProxy.Credentials = new NetworkCredential(Uri.UnescapeDataString(credentials[0]),
+                        credentials.Length > 1 ? Uri.UnescapeDataString(credentials[1]) : "");
+                }
+                handler.Proxy = configuredProxy;
+            }
+            using var client = new HttpClient(handler) { Timeout = TimeSpan.FromMinutes(10) };
+            client.DefaultRequestHeaders.UserAgent.ParseAdd("GakumasHelperUpdater/1");
+            if (!string.IsNullOrWhiteSpace(secrets.Token)) client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", secrets.Token);
+            GitHubApiRequests.SharedRoot = plan.Root;
+            try
+            {
+                using var parent = Process.GetProcessById(plan.ParentPid);
+                if (parent.StartTime.ToUniversalTime().Ticks == plan.ParentStart && !parent.WaitForExit(60000))
+                    throw new IOException("程序尚未退出，已取消更新。");
+            }
+            catch (ArgumentException) { /* Parent already exited. */ }
+            Execute(plan, client).GetAwaiter().GetResult();
+            WriteResult(plan, "success", "更新完成，已核对全部目标文件。");
+            Process.Start(new ProcessStartInfo(PathIn(plan.Root, plan.Executable)) { UseShellExecute = true, WorkingDirectory = plan.Root });
+            return 0;
+        }
+        catch (Exception error)
+        {
+            if (plan != null) WriteResult(plan, "failed", error.Message);
+            if (OperatingSystem.IsWindows())
+                ShowFailure(IntPtr.Zero, "更新未完成。" + Environment.NewLine + error.Message, "MaaGakumasu 更新", 0x10);
+            return 1; // Do not launch a client from a potentially incomplete rollback.
+        }
+    }
+    [System.Runtime.InteropServices.DllImport("user32.dll", EntryPoint = "MessageBoxW", CharSet = System.Runtime.InteropServices.CharSet.Unicode)]
+    private static extern int ShowFailure(IntPtr window, string text, string caption, uint type);
+    private static void WriteResult(Plan plan, string status, string message)
+    {
+        var directory = Path.Combine(plan.Root, ".local", "runtime-data");
+        Directory.CreateDirectory(directory);
+        File.WriteAllText(Path.Combine(directory, "update-result.json"), JsonSerializer.Serialize(new { status, message, target = plan.Target.target.version }));
+    }
+}
