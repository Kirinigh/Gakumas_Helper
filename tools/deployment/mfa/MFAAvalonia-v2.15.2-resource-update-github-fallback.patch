+    }
+    internal static Asset ResolveAsset(JsonObject release, string name)
+    {
+        var matches = release["assets"]!.AsArray().OfType<JsonObject>().Where(a => (string?)a["name"] == name).ToArray();
+        if (matches.Length != 1) throw new InvalidDataException("缺少或重复的更新附件：" + name);
+        var item = matches[0];
+        var hash = ((string?)item["digest"] ?? "").Replace("sha256:", "");
+        var url = (string?)item["url"] ?? "";
+        if (!ValidHash(hash) || !Uri.TryCreate(url, UriKind.Absolute, out var uri) || uri.Scheme != "https" || uri.Host != "api.github.com")
+            throw new InvalidDataException("更新附件缺少可靠下载信息。");
+        return new Asset { name = name, url = url, sha256 = hash, bytes = (long?)item["size"] ?? 0 };
+    }
+    internal static async Task Download(HttpClient client, Asset asset, string target, Budget budget,
+        Action<string, long, long>? progress = null)
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+        while (true)
+        {
+            try
+            {
+                progress?.Invoke("正在下载 " + asset.name, 0, asset.bytes);
+                using var request = new HttpRequestMessage(HttpMethod.Get, asset.url);
+                request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/octet-stream"));
+                using var response = await GitHubApiRequests.SendAsync(client, request, HttpCompletionOption.ResponseHeadersRead).ConfigureAwait(false);
+                response.EnsureSuccessStatusCode();
+                await using (var input = await response.Content.ReadAsStreamAsync().ConfigureAwait(false))
+                await using (var output = new FileStream(target, FileMode.CreateNew, FileAccess.Write))
+                {
+                    var buffer = new byte[81920];
+                    long received = 0;
+                    var clock = Stopwatch.StartNew();
+                    long lastReport = -250;
+                    while (true)
+                    {
+                        using var idle = new CancellationTokenSource(TimeSpan.FromSeconds(60));
+                        var count = await input.ReadAsync(buffer.AsMemory(), idle.Token).ConfigureAwait(false);
+                        if (count == 0) break;
+                        await output.WriteAsync(buffer.AsMemory(0, count), idle.Token).ConfigureAwait(false);
+                        received += count;
+                        if (received > asset.bytes) throw new InvalidDataException("更新附件超过声明长度。");
+                        if (clock.ElapsedMilliseconds - lastReport >= 250 || received == asset.bytes)
+                        {
+                            progress?.Invoke("正在下载 " + asset.name, received, asset.bytes);
+                            lastReport = clock.ElapsedMilliseconds;
+                        }
+                    }
+                    await output.FlushAsync().ConfigureAwait(false);
+                }
+                progress?.Invoke("正在校验 " + asset.name, asset.bytes, asset.bytes);
+                if (new FileInfo(target).Length != asset.bytes || !Hash(target).Equals(asset.sha256, StringComparison.OrdinalIgnoreCase))
+                    throw new InvalidDataException("更新附件校验失败。");
+                return;
+            }
+            catch (GitHubRateLimitException) { throw; }
+            catch (InvalidDataException)
+            {
+                if (File.Exists(target)) File.Delete(target);
+                throw;
+            }
+            catch (Exception error) when (error is IOException or HttpRequestException or OperationCanceledException)
+            {
+                if (File.Exists(target)) File.Delete(target);
+                if (budget.Remaining-- <= 0) throw;
+                progress?.Invoke("下载中断，正在重试 " + asset.name, 0, asset.bytes);
+                await Task.Delay(2000).ConfigureAwait(false);
+            }
+        }
+    }
+    internal static async Task<Plan> Prepare(string root, string work, string localVersion, string targetVersion,
+        List<JsonObject> catalog, HttpClient client, Action<string, long, long>? progress = null)
+    {
+        var releases = catalog.Where(r => (bool?)r["draft"] != true && (bool?)r["prerelease"] != true)
+            .GroupBy(r => (string?)r["tag_name"] ?? "").ToDictionary(g => g.Key, g => g.Single());
+        var plan = new Plan { Root = root, Work = work };
+        var downloadingDelta = false;
+        var cache = new Dictionary<string, Metadata>();
+        async Task<Metadata> MetadataFor(string tag)
+        {
+            if (cache.TryGetValue(tag, out var cached)) return cached;
+            if (!releases.TryGetValue(tag, out var release)) throw new InvalidDataException("增量链缺少正式版本。");
+            var asset = ResolveAsset(release, $"GakumasHelper-release-{tag}.json");
+            if (asset.bytes <= 0 || asset.bytes > 16 * 1024 * 1024) throw new InvalidDataException("版本清单体积无效。");
+            var path = Path.Combine(work, tag + ".json");
+            await Download(client, asset, path, plan.Budget, progress);
+            var document = JsonNode.Parse(await File.ReadAllTextAsync(path))!.AsObject();
+            var metadata = document["file_update"]?.Deserialize<Metadata>() ?? throw new NotSupportedException("目标仅提供完整更新。");
+            if (metadata.protocol != 1 || metadata.target.version != tag || !ValidHash(metadata.state_sha256)) throw new InvalidDataException("版本清单不匹配。");
+            ValidateState(metadata.target);
+            cache[tag] = metadata;
+            return metadata;
+        }
+        plan.Target = await MetadataFor(targetVersion);
+        plan.Full = ResolveAsset(releases[targetVersion], $"MaaGakumasu-win-x86_64-{targetVersion}.zip");
+        try
