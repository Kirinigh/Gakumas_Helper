+            || parts[^1] is "config.json" or "appsettings.json" or "maa.log" or "gui.log"
+            || parts[^1].EndsWith(".pyc") || parts[^1].EndsWith(".backupmfa");
+    }
+    internal static string PathIn(string root, string relative)
+    {
+        if (string.IsNullOrWhiteSpace(relative) || relative.Contains('\\') || relative.Contains(':')
+            || relative.Split('/').Any(p => p is "" or "." or ".." || p.EndsWith('.') || p.EndsWith(' ')) || Protected(relative))
+            throw new InvalidDataException("更新包含有无效路径或用户数据路径。");
+        var result = Path.GetFullPath(Path.Combine(root, relative));
+        var parent = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+        if (!result.StartsWith(parent, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("更新路径越界。");
+        for (var current = result; current.Length >= parent.Length; current = Path.GetDirectoryName(current)!)
+            if ((File.Exists(current) || Directory.Exists(current)) && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
