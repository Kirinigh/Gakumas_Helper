+    private static IEnumerable<string> FindExportFiles(
+        string baseDirectory, string root, List<string>? issues, Func<string, bool>? visitDirectory = null)
+    {
+        bool exists;
+        try { exists = (File.GetAttributes(root) & FileAttributes.Directory) != 0; }
+        catch (DirectoryNotFoundException) { exists = false; }
+        catch (FileNotFoundException) { exists = false; }
+        catch (Exception ex)
+        {
+            RecordExportIssue(issues, baseDirectory, root, ex);
+            exists = false;
+        }
+        if (!exists) yield break;
+        var pending = new Stack<string>();
+        pending.Push(root);
+        while (pending.Count > 0)
+        {
+            var directory = pending.Pop();
+            string[] files;
+            string[] directories;
+            try
+            {
+                files = Directory.GetFiles(directory);
+                directories = Directory.GetDirectories(directory);
+            }
+            catch (Exception ex)
+            {
+                RecordExportIssue(issues, baseDirectory, directory, ex);
+                continue;
+            }
+            foreach (var file in files)
+                yield return file;
+            foreach (var child in directories)
+            {
+                if (visitDirectory != null && !visitDirectory(child))
+                    continue;
+                try
+                {
+                    if ((File.GetAttributes(child) & FileAttributes.ReparsePoint) == 0)
+                        pending.Push(child);
+                }
+                catch (Exception ex) { RecordExportIssue(issues, baseDirectory, child, ex); }
+            }
+        }
+    }
+
+    private static void RecordExportIssue(List<string>? issues, string baseDirectory, string path, Exception error)
+    {
+        // Compatibility discovery of custom.log can cross unrelated folders;
+        // only failures in a selected, known diagnostic root are actionable.
+        if (issues == null) return;
+        var message = $"{Path.GetRelativePath(baseDirectory, path)}: {error.GetType().Name}";
+        if (!issues.Contains(message))
+            issues.Add(message);
+        LoggerHelper.Warning($"未能导出日志或图片：{message}");
+    }
