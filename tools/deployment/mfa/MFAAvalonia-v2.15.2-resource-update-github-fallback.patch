+        }
+        lines.Add("");
+        lines.Add($"未能读取的项目（{issues.Count}）：");
+        lines.AddRange(issues);
+        File.WriteAllLines(Path.Combine(destination, "export-report.txt"), lines, new System.Text.UTF8Encoding(false));
+    }
