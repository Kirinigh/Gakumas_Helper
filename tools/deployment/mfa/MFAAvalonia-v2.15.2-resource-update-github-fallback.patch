diff --git a/MFAAvalonia/Helper/DynamicOptionCases.cs b/MFAAvalonia/Helper/DynamicOptionCases.cs
new file mode 100644
--- /dev/null
+++ b/MFAAvalonia/Helper/DynamicOptionCases.cs
@@ -0,0 +1,141 @@
+using MFAAvalonia.Extensions.MaaFW;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.RegularExpressions;
+
+namespace MFAAvalonia.Helper;
+
+/// <summary>Refresh an explicitly dynamic select without changing saved case indices.</summary>
+internal static class DynamicOptionCases
+{
+    internal static bool TryRefresh(string? name, MaaInterface.MaaInterfaceOption option, string path)
+    {
+        if (!option.DynamicCases || !option.IsSelect || string.IsNullOrWhiteSpace(name)) return false;
+        try
+        {
+            var document = JObject.Parse(File.ReadAllText(path));
+            if (document["option"] is not JObject options || options[name] is not JObject incoming)
+                return false;
+            if (incoming["dynamic_cases"]?.Type != JTokenType.Boolean
+                || incoming["dynamic_cases"]!.Value<bool>() != true
+                || !string.Equals(incoming["type"]?.Value<string>() ?? "select", "select", StringComparison.OrdinalIgnoreCase)
+                || incoming["cases"] is not JArray cases)
+                return false;
+
+            var incomingOption = incoming.ToObject<MaaInterface.MaaInterfaceOption>();
+            var updated = incomingOption?.Cases;
+            var current = option.Cases;
+            if (current == null || updated == null || updated.Count < current.Count
+                || updated.Any(c => c == null || string.IsNullOrWhiteSpace(c.Name))
+                || updated.Select(c => c.Name).Distinct(StringComparer.Ordinal).Count() != updated.Count)
+                throw new InvalidDataException("Dynamic cases must retain the existing prefix and unique names.");
+
+            foreach (var alias in updated.Where(c => c.ReplacementCase != null))
+            {
+                var target = updated.FirstOrDefault(c => c.Name == alias.ReplacementCase);
+                if (target == null || target.ReplacementCase != null)
+                    throw new InvalidDataException($"Replacement for '{alias.Name}' must name a concrete case.");
+            }
+            if (incomingOption!.DefaultCases?.Any(name => !updated.Any(c => c.Name == name && c.ReplacementCase == null)) == true)
+                throw new InvalidDataException("Dynamic defaults must name concrete cases.");
+
+            // Only display text can change at an existing index. Validate the entire update
+            // before applying it so a partial or incompatible file cannot alter a selection.
+            for (var index = 0; index < current.Count; index++)
+            {
+                var before = current[index];
+                var after = updated[index];
+                if (before.Name != after.Name || before.Icon != after.Icon
+                    || !JToken.DeepEquals(JToken.FromObject(new { before.Option, before.PipelineOverride }),
+                        JToken.FromObject(new { after.Option, after.PipelineOverride })))
+                    throw new InvalidDataException($"Dynamic case at index {index} changed its identity or behavior.");
+            }
+
+            var changed = updated.Count != current.Count
+                || !JToken.DeepEquals(JToken.FromObject(new { Value = option.DefaultCases }),
+                    JToken.FromObject(new { Value = incomingOption.DefaultCases }));
+            for (var index = 0; index < current.Count; index++)
+            {
+                if (current[index].Label == updated[index].Label && current[index].Description == updated[index].Description
+                    && current[index].ReplacementCase == updated[index].ReplacementCase
+                    && JToken.DeepEquals(JToken.FromObject(new { current[index].LabelArgs }),
+                        JToken.FromObject(new { updated[index].LabelArgs })))
+                    continue;
+                current[index].Label = updated[index].Label;
+                current[index].LabelArgs = updated[index].LabelArgs;
+                current[index].ReplacementCase = updated[index].ReplacementCase;
+                current[index].Description = updated[index].Description;
+                current[index].RefreshDisplayMetadata();
+                changed = true;
+            }
+            foreach (var added in updated.Skip(current.Count))
+            {
+                added.InitializeDisplayName();
+                current.Add(added);
+            }
+            option.DefaultCases = incomingOption.DefaultCases;
+            return changed;
+        }
+        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or JsonException or ArgumentException)
+        {
+            LoggerHelper.Warning($"Could not refresh dynamic option '{name}': {ex.Message}");
+            return false;
+        }
+    }
+
+    internal static IList<MaaInterface.MaaInterfaceOptionCase>? DisplayCases(MaaInterface.MaaInterfaceOption option)
+    {
+        if (!option.DynamicCases || !option.IsSelect || option.Cases == null) return option.Cases;
+        // The interface list remains append-only; this is a display copy.
+        return option.Cases.Where(c => c.ReplacementCase == null).OrderBy(c => c.Name == "latest" ? 0 : 1)
+            .ThenByDescending(c => TrailingNumber(c.Name)).ToList();
+    }
+
+    internal static bool ResolveSelection(MaaInterface.MaaInterfaceSelectOption selection, MaaInterface.MaaInterfaceOption option)
+    {
+        if (!option.DynamicCases || !option.IsSelect || option.Cases is not { Count: > 0 } cases) return false;
+        var index = selection.Index ?? Math.Max(0, cases.FindIndex(c => c.Name == option.DefaultCase));
+        if (index < 0 || index >= cases.Count) return false;
+        if (cases[index].ReplacementCase is { } replacement)
+        {
+            var resolved = cases.FindIndex(c => c.Name == replacement && c.ReplacementCase == null);
+            if (resolved < 0) return false;
+            index = resolved;
+        }
+        if (selection.Index == index) return false;
+        selection.Index = index;
+        return true;
+    }
+
+    internal static bool RefreshSelections(IEnumerable<MaaInterface.MaaInterfaceSelectOption> selections,
+        Dictionary<string, MaaInterface.MaaInterfaceOption>? definitions, string path)
+    {
+        if (definitions == null) return false;
+        var refreshed = new HashSet<string>(StringComparer.Ordinal);
+        var changed = false;
+        void Visit(IEnumerable<MaaInterface.MaaInterfaceSelectOption> options)
+        {
+            foreach (var selection in options)
+            {
+                if (selection.Name is { } name && definitions.TryGetValue(name, out var definition))
+                {
+                    if (refreshed.Add(name)) TryRefresh(name, definition, path);
+                    changed |= ResolveSelection(selection, definition);
+                }
+                if (selection.SubOptions != null) Visit(selection.SubOptions);
+            }
+        }
+        Visit(selections);
+        return changed;
+    }
+
+    private static long TrailingNumber(string? name)
+    {
+        var suffix = Regex.Match(name ?? string.Empty, @"\d+$").Value;
+        return long.TryParse(suffix, out var number) ? number : -1;
+    }
+}
