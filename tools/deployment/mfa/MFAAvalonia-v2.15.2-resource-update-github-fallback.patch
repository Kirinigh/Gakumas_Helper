+                if (delta.to != cursor.target.version || !SameLine(delta.from, delta.to)
+                    || Stable(delta.from) < Stable(localVersion) || delta.@base.version != delta.from
+                    || !JsonNode.DeepEquals(delta.@base.compatibility, cursor.target.compatibility)) throw new InvalidDataException("增量基底或兼容条件不符。");
