+            options == null ? "范围：旧入口，最近五天。" : "范围：按导出窗口所选项目。",
+            $"框架日志：{selected.IncludeMaaLog}；界面日志：{selected.IncludeGuiLog}；自定义详细日志：{selected.IncludeCustomLog}",
+            $"失败图片：{selected.IncludeOnErrorImages} / {selected.OnErrorImageTimeRange}；识别图片：{selected.IncludeVisionImages} / {selected.VisionImageTimeRange}；其它图片：{selected.IncludeOtherImages} / {selected.OtherImageTimeRange}",
+            "Agent 详细日志位于 .local/runtime-data/logs；失败元数据位于 .local/arena-win-rate/reader-failures。",
+            "未生成失败证据目录是正常情况；未勾选或超出时间范围的项目不在包内。",
+            "完整导出仅表示所选文件已复制，不表示失败现场信息完整；图片本身不含错误码和成员位置。",
+            $"Agent 日志目录存在：{Directory.Exists(Path.Combine(baseDirectory, ".local", "runtime-data", "logs"))}",
+            $"失败证据目录存在：{Directory.Exists(Path.Combine(baseDirectory, ".local", "arena-win-rate", "reader-failures"))}",
+            "",
+            $"已包含文件（{copiedPaths.Count}）："
+        };
+        lines.AddRange(copiedPaths.OrderBy(path => path, StringComparer.Ordinal));
+        var failurePrefix = Path.Combine(".local", "arena-win-rate", "reader-failures") + Path.DirectorySeparatorChar;
+        foreach (var imageFolder in copiedPaths.Where(path => path.StartsWith(failurePrefix, StringComparison.OrdinalIgnoreCase)
