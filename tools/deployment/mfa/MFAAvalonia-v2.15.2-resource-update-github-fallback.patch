+        }
+    }
+    private static bool ValidHash(string value) => System.Text.RegularExpressions.Regex.IsMatch(value, "^[a-fA-F0-9]{64}$");
+    private static IEnumerable<string> ManagedFiles(string root)
+    {
+        var pending = new Stack<string>();
+        pending.Push(root);
+        while (pending.TryPop(out var directory))
+        {
+            foreach (var entry in Directory.EnumerateFileSystemEntries(directory))
+            {
+                var relative = Path.GetRelativePath(root, entry).Replace('\\', '/');
+                if (Protected(relative)) continue;
+                PathIn(root, relative);
+                if (Directory.Exists(entry)) pending.Push(entry);
