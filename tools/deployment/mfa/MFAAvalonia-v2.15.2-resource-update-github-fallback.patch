+            }
+        }
+    }
+    internal static bool RuntimeRefreshPath(string path) => path.Equals("interface.json", StringComparison.OrdinalIgnoreCase)
+        || path.StartsWith("python/Lib/site-packages/", StringComparison.OrdinalIgnoreCase)
+        || path.StartsWith("python/Scripts/", StringComparison.OrdinalIgnoreCase);
+    internal static void VerifyTree(string root, State state, string? stateHash = null, bool refreshRuntime = false)
+    {
+        ValidateState(state);
