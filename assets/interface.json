    "arena_recalculate_own_score_parameters": {
      "type": "input",
      "label": "己方总分重算参数",
      "description": "每日挑战默认复用己方缓存；首次使用、期数或编成变化后可手动运行本任务，也可在每日挑战的胜率模式中临时启用自动重算。任务说明会显示当前缓存摘要。",
      "inputs": [
        {
          "name": "arena_own_score_simulations",
          "label": "模拟次数",
          "default": "2000",
          "pipeline_type": "int",
          "verify": "^[1-9]\\d{3,}$"
        },
        {
          "name": "arena_own_score_timeout_seconds",
          "label": "模拟超时（秒）",
          "default": "180",
          "pipeline_type": "int",
          "verify": "^[1-9]\\d*$"
        }
      ],
      "pipeline_override": {
        "ChallengeChoose": {
          "on_error": [
            "ChallengeWinRateStop"
          ],
          "custom_action_param": {
            "mode": "win_rate_recalculate_own",
            "threshold_percent": 70,
            "simulations": "{arena_own_score_simulations}",
            "timeout_seconds": "{arena_own_score_timeout_seconds}"
          }
        }
      }
    },
    "每日挑战本地画面采集": {
      "type": "select",
      "default_case": "关闭",
      "description": "$本地画面采集说明",
      "cases": [
        {
          "name": "关闭",
          "label": "$关闭",
          "pipeline_override": {
            "LocalDataConfigureChallenge": {
              "custom_action_param": {
                "capture_mode": "off",
                "root": ".local/runtime-data"
              }
            }
          }
        },
        {
          "name": "仅失败现场",
          "label": "$仅失败现场",
          "pipeline_override": {
            "LocalDataConfigureChallenge": {
              "custom_action_param": {
                "capture_mode": "failure",
                "root": ".local/runtime-data"
              }
            }
          }
        },
        {
          "name": "ROI与失败现场",
          "label": "$ROI与失败现场",
          "pipeline_override": {
            "LocalDataConfigureChallenge": {
              "custom_action_param": {
                "capture_mode": "roi",
                "root": ".local/runtime-data"
              }
            }
          }
        },
        {
          "name": "截图ROI与失败现场",
          "label": "$截图ROI与失败现场",
          "pipeline_override": {
            "LocalDataConfigureChallenge": {
              "custom_action_param": {
                "capture_mode": "screenshot",
                "root": ".local/runtime-data"
              }
            }
          }
        }
      ],
      "label": "$本地画面采集"
    },
    "挑战模式": {
      "type": "select",
      "default_case": "胜率选敌",
      "cases": [
        {
          "name": "胜率选敌",
          "label": "$胜率选敌",
          "description": "$胜率选敌说明",
          "option": [
            "竞技场期数",
            "竞技场 Grade",
            "竞技场胜率参数",
            "每日挑战自动重算己方数据"
          ],
          "pipeline_override": {
            "ChallengeChoose": {
              "on_error": [
                "ChallengeWinRateStop"
              ],
              "custom_action_param": {
                "mode": "win_rate"
              }
            }
          }
        },
        {
          "name": "自动",
          "label": "$自动",
          "pipeline_override": {
            "ChallengeChoose": {
              "custom_action_param": {
                "mode": "auto"
              }
            }
          }
        },
        {
          "name": "最大值",
          "label": "$最大值",
          "pipeline_override": {
            "ChallengeChoose": {
              "custom_action_param": {
                "mode": "max"
              }
            }
          }
        },
        {
          "name": "最小值",
