          "pipeline_override": {
            "ChallengeChoose": {
              "custom_action_param": {
                "mode": "min"
              }
            }
          }
        },
        {
          "name": "随机",
          "label": "$随机",
          "pipeline_override": {
            "ChallengeChoose": {
              "custom_action_param": {
                "mode": "random"
              }
            }
          }
        },
        {
          "name": "固定第一位",
          "label": "$固定第一位",
          "pipeline_override": {
            "ChallengeChoose": {
              "custom_action_param": {
                "mode": "fixed",
                "index": 0
