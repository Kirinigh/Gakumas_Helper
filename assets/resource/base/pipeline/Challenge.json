      }
    },
    "on_error": [
      "ChallengeWinRateStop"
    ],
    "next": [
      "ChallengeSelector"
    ]
  },
  "ChallengeResetOwnScorePreparation": {
    "recognition": {
      "type": "DirectHit",
      "param": {}
