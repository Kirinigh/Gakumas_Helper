    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "IdolRoadContinueRetry"
      }
    },
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadAuto",
      "IdolRoadStart"
    ],
    "post_wait_freezes": 500,
    "focus": {
      "Node.Recognition.Succeeded": {
        "content": "[color:OrangeRed]❌ 挑战失败，建议手动更换回忆[/color]",
        "display": [
          "log"
        ]
      }
    }
  },
  "IdolRoadRetryFocus": {
    "recognition": {
      "type": "DirectHit",
      "param": {}
    },
    "action": {
      "type": "DoNothing",
      "param": {}
    },
    "focus": {
      "Node.Recognition.Succeeded": {
        "content": "[color:OrangeRed]❌ 挑战失败已到上限 [/color]",
        "display": [
          "log",
          "notification"
        ]
      }
    }
  },
  "IdolRoadAutoNext": {
    "recognition": {
      "type": "TemplateMatch",
