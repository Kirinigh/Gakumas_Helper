  "IdolRoadStartFlag": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "challenge_action.png",
        "roi": [
          0,
          880,
          720,
          185
        ]
      }
    },
    "action": {
      "type": "Click",
      "param": {}
    },
