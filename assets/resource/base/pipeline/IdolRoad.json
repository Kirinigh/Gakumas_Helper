{
  "IdolRoad": {
    "recognition": {
      "type": "DirectHit",
      "param": {}
    },
    "action": {
      "type": "DoNothing",
      "param": {}
    },
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadResumeSaved",
      "IdolRoadFormationPage",
      "IdolRoadFloorOverview",
      "IdolRoadResumeBattle",
      "IdolRoadResumeRetryDialog",
      "IdolRoadResumeRanking",
      "IdolRoadRankingUpdate",
      "IdolRoadResumeClearRetry",
      "IdolRoadResumeClear",
      "IdolRoadResumeFailedRanking",
      "IdolRoadNavigate"
    ]
  },
  "IdolRoadResumeDate": {
    "recognition": "Custom",
    "custom_recognition": "IdolRoadDateNotice",
    "action": "Custom",
    "custom_action": "IdolRoadResumeDate",
    "next": [
      "IdolRoadResumeSaved",
      "IdolRoadResumeBattle",
      "IdolRoadFloorOverview",
      "IdolRoadFormationPage"
    ]
  },
  "IdolRoadResumeSaved": {
    "recognition": "Custom",
    "custom_recognition": "IdolRoadSavedChallenge",
    "action": "Click",
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadResumeBattle",
      "IdolRoadResumeRanking",
      "IdolRoadResumeFailedRanking"
    ]
  },
  "IdolRoadResumeBattle": {
    "recognition": "Custom",
    "custom_recognition": "IdolRoadExamVisible",
    "action": "Custom",
    "custom_action": "IdolRoadPolicyBattle",
    "custom_action_param": {
      "resume": true
    },
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadFloorOverview",
      "IdolRoadFormationPage",
      "IdolRoadStartNextFlag"
    ]
  },
  "IdolRoadResumeRanking": {
    "recognition": "And",
    "all_of": [
      "IdolRoadAutoNext",
      {
        "recognition": "Or",
        "any_of": [
          {
            "recognition": "Custom",
            "roi": [
              0,
              125,
              205,
              145
            ],
            "custom_recognition": "LiveSimdOCR",
            "custom_recognition_param": {
              "expected": [
                "[1-6]\\s*位",
                "^位$"
              ]
            }
          },
          {
            "recognition": "Custom",
            "custom_recognition": "IdolRoadRankingVisible"
          }
        ]
      }
    ],
    "box_index": 0,
    "action": "Custom",
    "custom_action": "IdolRoadResultContinue",
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadRankingUpdate",
      "IdolRoadResumeClearRetry",
      "IdolRoadResumeClear"
    ]
  },
  "IdolRoadResumeClearRetry": {
    "recognition": "And",
    "all_of": [
      "IdolRoadRetry",
      {
        "recognition": "Custom",
        "custom_recognition": "IdolRoadClearVisible",
        "custom_recognition_param": {
          "titles": [
            "CLEAR"
          ]
        }
      }
    ],
    "box_index": 0,
    "action": "Custom",
    "custom_action": "IdolRoadResultContinue",
    "custom_action_param": {
      "clear_retry": true
    },
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadRetryConfirm"
    ],
    "on_error": [
      "IdolRoadResumeClear"
    ]
  },
  "IdolRoadResumeRetryDialog": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "Custom",
        "roi": [
          0,
          900,
          720,
          360
        ],
        "custom_recognition": "LiveSimdOCR",
        "custom_recognition_param": {
          "expected": [
            "同じ編成で再挑戦"
          ]
        }
      },
      "IdolRoadRetryConfirm"
    ],
    "box_index": 1,
    "action": "DoNothing",
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadRetryConfirm"
    ]
  },
  "IdolRoadResumeClear": {
    "recognition": "And",
    "all_of": [
      "IdolRoadBackToList",
      {
        "recognition": "Custom",
        "custom_recognition": "IdolRoadClearVisible",
        "custom_recognition_param": {
          "titles": [
            "CLEAR",
            "PERFECT"
          ]
        }
      }
    ],
    "box_index": 0,
    "action": "Custom",
    "custom_action": "IdolRoadResultContinue",
    "next": [
      "IdolRoadFloorOverview",
      "IdolRoadFormationPage",
      "IdolRoadStartNextFlag"
    ]
  },
  "IdolRoadResumeFailedRanking": {
    "recognition": "And",
    "all_of": [
      "IdolRoadRetry",
      {
        "recognition": "Or",
        "any_of": [
          {
            "recognition": "Custom",
            "roi": [
              0,
              100,
              270,
              160
            ],
            "custom_recognition": "LiveSimdOCR",
            "custom_recognition_param": {
              "expected": [
                "不合格"
              ]
            }
          },
          {
            "recognition": "Custom",
            "custom_recognition": "IdolRoadRankingVisible",
            "custom_recognition_param": {
              "failed": true
            }
          }
        ]
      }
    ],
    "box_index": 0,
    "action": "Custom",
    "custom_action": "IdolRoadResultContinue",
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadRetryConfirm"
    ]
  },
  "IdolRoadNavigate": {
    "enabled": false,
