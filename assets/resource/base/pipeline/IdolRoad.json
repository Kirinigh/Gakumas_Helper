  "IdolRoadRetry": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "challenge_retry.png"
      }
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "IdolRoadResultContinue"
