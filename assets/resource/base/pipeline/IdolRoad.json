        "custom_action": "IdolRoadNavigate",
        "custom_action_param": {
          "idol": ""
        }
      }
    },
    "next": [
      "IdolRoadResumeDate",
      "IdolRoadResumeSaved",
      "IdolRoadResumeBattle",
      "IdolRoadFloorOverview"
    ]
  },
  "IdolRoadFloorOverview": {
    "recognition": {
      "type": "Custom",
